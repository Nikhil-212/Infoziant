# VehicleVault — Environment Variables
#
# HOW TO USE:
#   cp .env.example .env
#   Fill in your own values.
#   NEVER commit .env to version control.
#
# For production, use a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# rather than a .env file on disk.

# ── MongoDB Credentials ────────────────────────────────────────────────────────
# Generate strong values for production — do NOT use the placeholders below.
# Example (Linux/macOS):  openssl rand -base64 24
MONGO_INITDB_ROOT_USERNAME=vaultuser
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# MongoDB database name (not the admin database)
MONGO_DB_NAME=vehiclevault

# ── Backend Configuration ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Upload directory — must match the volume mount path in compose.yaml
UPLOAD_DIR=/app/uploads

# Maximum PDF upload size in megabytes
MAX_UPLOAD_SIZE_MB=10

# ── Host Port ──────────────────────────────────────────────────────────────────
# The host port Nginx listens on. Change to 443 when configuring HTTPS.
HOST_PORT=80

# ── Notes ─────────────────────────────────────────────────────────────────────
# MONGODB_URI is constructed from the above variables in compose.yaml.
# If you set MONGODB_URI explicitly here, it overrides the individual settings.
# MONGODB_URI=mongodb://vaultuser:password@mongodb:27017/vehiclevault?authSource=admin
